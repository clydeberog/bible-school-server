# Runtime mode ("production" when self-hosting on Ubuntu)
NODE_ENV="production"

# Port Express listens on (Cloudflare Tunnel forwards to 127.0.0.1:3000)
PORT="3000"

# Public URL where your Cloudflare Tunnel routes traffic
APP_URL="https://lms.yourdomain.com"

# Google Maps Platform API key (Maps JavaScript API + Places API New enabled)
VITE_GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY"

# HMAC-SHA256 secret for signing presigned local upload/download tokens (/api/storage/*)
# Generate on Ubuntu with: openssl rand -hex 32
STORAGE_SIGNING_SECRET="YOUR_RANDOM_64_CHAR_HEX_SECRET"
